{
  "name": "@utaba/deep-memory-indexer-llm-anthropic",
  "version": "1.0.0",
  "private": true,
  "description": "Anthropic LLM provider for @utaba/deep-memory-indexer — prompt caching + Files API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TjWheeler/deep-memory.git",
    "directory": "packages/indexer-llm-anthropic"
  },
  "bugs": {
    "url": "https://github.com/TjWheeler/deep-memory/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai",
    "memory",
    "graph",
    "knowledge-graph",
    "indexing",
    "extraction",
    "anthropic",
    "claude",
    "prompt-caching",
    "agents"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0"
  },
  "peerDependencies": {
    "@utaba/deep-memory": "workspace:^",
    "@utaba/deep-memory-indexer": "workspace:^"
  },
  "devDependencies": {
    "@utaba/deep-memory": "workspace:*",
    "@utaba/deep-memory-indexer": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
