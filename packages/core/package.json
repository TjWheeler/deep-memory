{
  "name": "@utaba/deep-memory",
  "version": "0.20.0",
  "description": "Vocabulary-driven graph memory for AI agents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./providers": {
      "import": {
        "types": "./dist/providers/index.d.ts",
        "default": "./dist/providers/index.js"
      },
      "require": {
        "types": "./dist/providers/index.d.cts",
        "default": "./dist/providers/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/types/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/conformance.d.ts",
        "default": "./dist/testing/conformance.js"
      },
      "require": {
        "types": "./dist/testing/conformance.d.cts",
        "default": "./dist/testing/conformance.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TjWheeler/deep-memory.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/TjWheeler/deep-memory/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai",
    "memory",
    "graph",
    "knowledge-graph",
    "mcp",
    "agents",
    "vocabulary"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
