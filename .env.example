# Local secrets for the Deep Memory MCP server.
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# Lines starting with `export ` are stripped by the loader, so the same file
# can also be sourced from a bash shell via: `source .env.local`.
#
# Values defined in `.mcp.json` env take precedence over anything set here,
# so secrets live here and non-secrets (hosts, ports, database names) stay in .mcp.json.

# Azure AI Foundry / OpenAI API key for the embeddings endpoint configured in .mcp.json
export DEEP_MEMORY_EMBEDDINGS_API_KEY=""

# SQL Server password for the `DEEP_MEMORY_SQL_USER` account in .mcp.json
export DEEP_MEMORY_SQL_PASSWORD=""

# CosmosDB primary key. For the local emulator this is the well-known default key;
# for a real account get it from the Azure portal > Keys.
export DEEP_MEMORY_COSMOSDB_KEY=""
