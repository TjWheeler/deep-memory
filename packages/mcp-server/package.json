{
  "name": "@utaba/deep-memory-local-mcp-server",
  "version": "0.20.0",
  "description": "Local MCP server exposing @utaba/deep-memory as tools for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "deep-memory-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TjWheeler/deep-memory.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/TjWheeler/deep-memory/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai",
    "memory",
    "graph",
    "knowledge-graph",
    "mcp",
    "model-context-protocol",
    "agents"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@utaba/deep-memory": "workspace:*",
    "@utaba/deep-memory-embeddings-openai": "workspace:*",
    "@utaba/deep-memory-storage-sqlserver": "workspace:*",
    "@utaba/deep-memory-storage-cosmosdb": "workspace:*",
    "@utaba/deep-memory-storage-neo4j": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.8"
  }
}
